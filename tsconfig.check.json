{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": false,
    "types": ["vite/client"]
  },
  "include": [
    "src/services/dataService.d.ts",
    "src/services/dataService.js",
    "src/services/dataService/**/*.js",
    "src/lib/supabase.js",
    "src/services/smsService.js",
    "src/utils/dataIntegrity.js"
  ],
  "exclude": ["node_modules", "dist"]
}
