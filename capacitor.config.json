{
  "appId": "com.viotrack.app",
  "appName": "VioTrack",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "buildOptions": {
      "keystorePath": "viotrack-release-key.keystore",
      "keystorePassword": "viotrack123",
      "keystoreAlias": "viotrack",
      "keystoreAliasPassword": "viotrack123",
      "releaseType": "APK"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0f172a"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#ffffff"
    }
  }
}
